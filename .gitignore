# ============================================================
# .gitignore tổng cho cả monorepo Booking
# ============================================================

# Node.js
node_modules/
**/node_modules/

# Environment files - TUYỆT ĐỐI KHÔNG COMMIT
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Build output
dist/
build/
**/dist/
**/build/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Docker
*.pid

# Coverage / Tests
coverage/
.nyc_output/

# Misc
.cache/
*.local
.vite/

# Certificates / Secrets - quan trọng
*.pem
*.key
*.cert
*.crt

# Exception: AWS RDS/DocumentDB CA bundle (PUBLIC, không phải secret)
!backend/global-bundle.pem
